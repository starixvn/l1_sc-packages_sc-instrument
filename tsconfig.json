{
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./lib",
        "lib": ["es5", "es6", "DOM"],
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "resolveJsonModule": true,
        "moduleResolution": "node",
        "allowJs": true
    },
    "exclude": ["tests/", "lib/", "node_modules/", "coverage/", "reports/"],
    "watchOptions": {
        "excludeDirectories": ["lib/*"]
    }
}
