{
    "name": "sc-instrument",
    "version": "1.1.2-beta.1",
    "description": "SC Intrumentation",
    "main": "./lib/index.js",
    "typings": "./lib/index.d.ts",
    "scripts": {
        "lint": "eslint .",
        "lint:fix": "eslint . --fix  && prettier --write '{src}/**/*.ts'",
        "prebuild": "rimraf lib",
        "build": "tsc",
        "build:watch": "tsc --watch",
        "test": "jest",
        "test-coverage": "jest --collect-coverage",
        "reg": "npm set registry https://npm.lumigame.com",
        "pub": "npm publish --registry https://npm.lumigame.com",
        "betaver": "npm version prerelease --preid beta",
        "pubbeta": "npm publish --registry https://npm.lumigame.com --tag beta",
        "semantic-release": "semantic-release"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "files": [
        "lib/"
    ],
    "repository": {
        "type": "git",
        "url": "https://git3.nexdev.net/sc-packages/sc-instrument.git"
    },
    "keywords": [
        "otel",
        "instrumentation"
    ],
    "author": {
        "email": "pentagon@luminetsoft.com",
        "name": "pentagon"
    },
    "license": "ISC",
    "dependencies": {
        "@opentelemetry/context-async-hooks": "1.25.1",
        "@opentelemetry/core": "1.25.1",
        "@opentelemetry/exporter-trace-otlp-proto": "0.52.1",
        "@opentelemetry/instrumentation": "0.52.1",
        "@opentelemetry/instrumentation-express": "^0.41.1",
        "@opentelemetry/instrumentation-fastify": "0.38.0",
        "@opentelemetry/instrumentation-http": "0.52.1",
        "@opentelemetry/instrumentation-mongoose": "0.40.0",
        "@opentelemetry/instrumentation-socket.io": "0.41.0",
        "@opentelemetry/propagator-b3": "1.25.1",
        "@opentelemetry/propagator-jaeger": "1.25.1",
        "@opentelemetry/resources": "1.25.1",
        "@opentelemetry/sdk-node": "0.52.1",
        "@opentelemetry/sdk-trace-base": "1.25.1",
        "@opentelemetry/sdk-trace-node": "1.25.1",
        "@opentelemetry/semantic-conventions": "1.25.1",
        "socket.io": "4.6.1"
    },
    "devDependencies": {
        "@babel/preset-env": "^7.12.11",
        "@commitlint/cli": "^9.1.2",
        "@commitlint/config-conventional": "^9.1.2",
        "@opentelemetry/api": "^1.1.0",
        "@semantic-release/changelog": "^5.0.1",
        "@semantic-release/commit-analyzer": "^8.0.1",
        "@semantic-release/git": "^9.0.0",
        "@semantic-release/gitlab": "^6.0.4",
        "@semantic-release/npm": "^7.0.5",
        "@semantic-release/release-notes-generator": "^9.0.1",
        "@types/jest": "^27.0.0",
        "@types/node": "^20.5.0",
        "babel-jest": "^27.0.0",
        "husky": "^4.2.5",
        "install": "^0.13.0",
        "jest": "^27.0.0",
        "jest-extended": "^0.11.5",
        "jest-micro-auto-stub": "^1.0.7",
        "jest-sonar-reporter": "^2.0.0",
        "rimraf": "^3.0.2",
        "sc-semantic-release": "^1.2.0",
        "semantic-release": "^17.1.1",
        "ts-jest": "^27.1.4",
        "ts-node": "^10.9.1",
        "typescript": "^5.1.3"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
